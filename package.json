{
	"name": "kinetic-toast",
	"version": "0.1.0",
	"description": "An opinionated, physics-based toast notification library for React.",
	"license": "MIT",
	"author": "Feldrok",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feldrok/kinetic-toast.git"
	},
	"bugs": {
		"url": "https://github.com/feldrok/kinetic-toast/issues"
	},
	"homepage": "https://github.com/feldrok/kinetic-toast#readme",
	"keywords": [
		"react",
		"toast",
		"notification",
		"notifications",
		"toaster",
		"motion",
		"kinetic"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE.md"
	],
	"scripts": {
		"build": "rm -rf dist && bunchee && cp src/styles.css dist/styles.css",
		"dev": "bunchee --watch",
		"prepack": "bun run build"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"bunchee": "^6.9.4"
	},
	"dependencies": {
		"motion": "^12.34.0"
	}
}
