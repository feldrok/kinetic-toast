{
	"name": "kinetic-toast",
	"version": "0.1.0",
	"description": "An opinionated, physics-based toast notification library for React.",
	"license": "MIT",
	"author": "Feldrok",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feldrok/kinetic-toast.git"
	},
	"bugs": {
		"url": "https://github.com/feldrok/kinetic-toast/issues"
	},
	"homepage": "https://github.com/feldrok/kinetic-toast#readme",
	"keywords": [
		"react",
		"toast",
		"notification",
		"notifications",
		"toaster",
		"motion",
		"kinetic"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE.md"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"dev": "node scripts/build.mjs --watch",
		"prepack": "bun run build",
		"registry:validate": "bunx --bun shadcn@latest registry validate",
		"registry:build": "bunx --bun shadcn@latest build --output public/r",
		"registry:check": "bun run registry:validate && bun run registry:build && bunx --bun shadcn@latest view ./public/r/kinetic-toast.json",
		"benchmark": "bun run build && node scripts/serve-benchmark.mjs",
		"benchmark:serve": "node scripts/serve-benchmark.mjs"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"bunchee": "^6.9.4"
	},
	"dependencies": {
		"motion": "^12.34.0"
	},
	"sideEffects": [
		"*.css",
		"**/*.css"
	]
}
